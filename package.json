{
  "name": "dsh-content-hub",
  "description": "Content Hub: atomize one source into reusable content atoms and adapt them across media (article, short video).",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./templates/*.yml": "./templates/*.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "templates/*.yml",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingHX/DSH-Content-Hub.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
